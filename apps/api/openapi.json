{
  "openapi": "3.1.0",
  "info": {
    "title": "Agent X API",
    "version": "1"
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "AGGREGATE_THRESHOLD",
                    "description": "Together with the same supplier's other open or paid requests in the aggregation window, this request crosses the approval threshold, so a person must approve it."
                  },
                  {
                    "type": "string",
                    "const": "BAD_REQUEST",
                    "description": "The request is malformed, so it can't be read."
                  },
                  {
                    "type": "string",
                    "const": "DUPLICATE_ORDER_REFERENCE",
                    "description": "An earlier request for the same supplier and order reference is still open, has an unknown outcome or was paid, so this one is refused."
                  },
                  {
                    "type": "string",
                    "const": "FORBIDDEN",
                    "description": "You're signed in, but this address answers other roles only, so the request is refused."
                  },
                  {
                    "type": "string",
                    "const": "HEADERS_TOO_LARGE",
                    "description": "The request's headers are larger than accepted, so it is refused. Large cookies are the usual cause."
                  },
                  {
                    "type": "string",
                    "const": "IDEMPOTENCY_KEY_BUSY",
                    "description": "An earlier request with this Idempotency-Key is still being done. Wait the number of seconds in the Retry-After header, then send the same request again with the same key."
                  },
                  {
                    "type": "string",
                    "const": "IDEMPOTENCY_KEY_INVALID",
                    "description": "This address changes something, so each request must carry an Idempotency-Key header: 1 to 255 visible ASCII characters, no spaces, new for each change you mean to make. Send the same key again only to retry the same request."
                  },
                  {
                    "type": "string",
                    "const": "IDEMPOTENCY_KEY_REUSED",
                    "description": "This Idempotency-Key was already used for a different request, so this one is refused and nothing was changed. Use a new key for a new change."
                  },
                  {
                    "type": "string",
                    "const": "INTERNAL_ERROR",
                    "description": "Something went wrong on our side, so the request failed. Quote the correlation ID if you contact support."
                  },
                  {
                    "type": "string",
                    "const": "NOT_FOUND",
                    "description": "There is nothing at this address, or the feature is not available."
                  },
                  {
                    "type": "string",
                    "const": "ORG_FROZEN",
                    "description": "The organisation is frozen, so no new request is accepted. This refusal is temporary: the same idempotency key can be used again once the freeze is lifted."
                  },
                  {
                    "type": "string",
                    "const": "ORIGIN_REFUSED",
                    "description": "A browser request that changes something must come from Agent X's own web address, and this one didn't, so it is refused."
                  },
                  {
                    "type": "string",
                    "const": "PAYLOAD_TOO_LARGE",
                    "description": "The request body is larger than this address accepts, so it is refused."
                  },
                  {
                    "type": "string",
                    "const": "RATE_LIMITED",
                    "description": "Too many requests came from this client address, or from this signed-in person, in the last minute. Wait the number of seconds in the Retry-After header, then try again."
                  },
                  {
                    "type": "string",
                    "const": "REQUEST_TIMEOUT",
                    "description": "The request took too long to arrive, so it is refused. Send it again."
                  },
                  {
                    "type": "string",
                    "const": "SIGN_IN_FAILED",
                    "description": "The sign-in couldn't be completed, so no session was opened. Start again from the sign-in page."
                  },
                  {
                    "type": "string",
                    "const": "SIGN_IN_UNAVAILABLE",
                    "description": "The sign-in service couldn't be reached just now, so no session was opened. Wait the number of seconds in the Retry-After header, then start again from the sign-in page."
                  },
                  {
                    "type": "string",
                    "const": "SUPPLIER_CHANGED",
                    "description": "The supplier's payment details changed after the request was decided, so it is refused before hand-off."
                  },
                  {
                    "type": "string",
                    "const": "UNAUTHENTICATED",
                    "description": "This address answers only a signed-in person or an agent with its key, and the request came from neither, so it is refused."
                  },
                  {
                    "type": "string",
                    "const": "UNSUPPORTED_MEDIA_TYPE",
                    "description": "The request body's content type isn't accepted at this address, so it is refused."
                  }
                ]
              },
              "message": {
                "type": "string"
              },
              "correlationId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "required": [
              "code",
              "message",
              "correlationId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "description": "Every refusal and failure has this body: a reason code, the code's public description, and the request's correlation ID. Nothing else."
      },
      "Session": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "authenticatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "idleExpiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "userId",
          "authenticatedAt",
          "methods",
          "idleExpiresAt",
          "expiresAt"
        ],
        "additionalProperties": false,
        "description": "The signed-in person's own session."
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Whether the API is up",
        "x-access": [
          "public"
        ],
        "responses": {
          "200": {
            "description": "Every check passed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false,
                  "description": "Every check passed."
                }
              }
            }
          },
          "503": {
            "description": "A check failed. The log says which; this answer never does.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "unavailable"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false,
                  "description": "A check failed. The log says which; this answer never does."
                }
              }
            }
          },
          "4XX": {
            "description": "Refused. The reason code says why.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "5XX": {
            "description": "Failed on our side. Quote the correlation ID if you contact support.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "head": {
        "summary": "Whether the API is up",
        "x-access": [
          "public"
        ],
        "responses": {
          "200": {
            "description": "Every check passed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false,
                  "description": "Every check passed."
                }
              }
            }
          },
          "503": {
            "description": "A check failed. The log says which; this answer never does.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "unavailable"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false,
                  "description": "A check failed. The log says which; this answer never does."
                }
              }
            }
          },
          "4XX": {
            "description": "Refused. The reason code says why.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "5XX": {
            "description": "Failed on our side. Quote the correlation ID if you contact support.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
