# What the image build may see (Dockerfile). Everything is left out unless
# listed: the manifests, the apps, the packages they use, and the database
# files (the bootstrap and the migrations). Test files and the test helpers
# never reach the image. The console's sources go to its build stage only; a
# build made outside the image is never taken in.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!apps/api/**
!apps/migrate/**
!apps/db-setup/**
!apps/operator/**
!apps/console/**
!packages/core/**
!packages/platform/**
!db/**
**/*.test.ts
**/*.test.tsx
apps/console/dist
**/node_modules
