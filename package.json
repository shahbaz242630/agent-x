{
  "name": "agent-x",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node --max-old-space-size=6144 tooling/quality/lint.ts",
    "duplicates": "jscpd",
    "typecheck": "tsc --project tsconfig.json && tsc --project apps/console/tsconfig.json",
    "boundaries": "depcruise apps packages",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "prettier --check . && node --max-old-space-size=6144 tooling/quality/lint.ts && tsc --project tsconfig.json && tsc --project apps/console/tsconfig.json && depcruise apps packages && knip && vitest run --coverage",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "load": "node tooling/load/run.ts",
    "hooks": "node tooling/git-hooks/install.ts",
    "tools": "node tooling/bicep/install.ts",
    "tools:cosign": "node tooling/cosign/install.ts"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.4",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "jscpd": "5.4.2",
    "jsdom": "30.1.3",
    "knip": "6.44.2",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
