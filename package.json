{
  "name": "agent-x",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --project tsconfig.json",
    "boundaries": "depcruise apps packages",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "prettier --check . && eslint --max-warnings 0 . && tsc --project tsconfig.json && depcruise apps packages && knip && vitest run --coverage",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "hooks": "node tooling/git-hooks/install.ts",
    "tools": "node tooling/bicep/install.ts"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.4",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.10.0",
    "fast-check": "4.10.0",
    "globals": "17.12.0",
    "knip": "6.35.1",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
