# Internal documentation: never committed. No trailing slash, so the rule also
# covers Documents when it is a symlink rather than a folder.
/Documents

# Secrets and local environment
.env
.env.*
!.env.example
# The local stack's login key pair, a PEM file each (deploy/compose/prepare.ts).
# The names have no extension, so the patterns below don't cover them.
/deploy/compose/secrets/
*.pem
*.key
*.p12
*.pfx
*.xlsx

# Dependencies and build output
node_modules/
# A two-file stand-in package that a module-boundary gate proof must see as installed.
!/tooling/gate-proofs/fixtures/boundaries/installed-cloud-sdk/node_modules/
dist/
build/
coverage/
.turbo/

# Logs
*.log
logs/

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local tools the hooks and `pnpm tools` install (the pinned gitleaks and Bicep)
.tools/

# What `bicep snapshot` writes beside a parameters file (deploy/azure): made on demand, never kept
deploy/azure/*.snapshot.json

# Local AI tooling
.claude/settings.local.json
.claude/worktrees/
.playwright-mcp/
